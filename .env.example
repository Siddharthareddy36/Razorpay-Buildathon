# Root Environment Variables Placeholder Template
# Copy this file to .env locally and fill in your values.
# NEVER commit real API keys or service role keys to git.

# Backend Configuration
PORT=5000
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Frontend Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Optional Future LLM Provider Variables (Phase 2+)
LLM_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
